node_modules/
.wrangler/
dist/
# M-UI operator console (spa/): ignore the build output, but KEEP a placeholder
# index.html so wrangler's assets.directory (./spa/dist) exists before `npm run
# build:ui` (the backend test pool + `wrangler deploy --dry-run` read that dir).
!spa/dist/
spa/dist/*
!spa/dist/index.html
.dev.vars
.env
.env.*
*.log
coverage/
.DS_Store
